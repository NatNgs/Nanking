{
	"name": "nanking",
	"version": "1.0.0",
	"description": "Sort things together",
	"main": "src/server/server.js",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"postinstall": "npm run build",
		"serve": "node src/server/server.js",
		"dev": "concurrently \"npm:serve\" \"npm:dev:client\"",
		"dev:client": "vite serve",
		"test": "cross-env ENV=test node --test --test-global-setup=test/globalSetup.js test/server/**/*.test.js",
		"test:integration": "vite build --mode development && cross-env ENV=test node --test --test-concurrency=1 --test-global-setup=test/integration/globalSetup.js test/integration/**/*.test.js",
		"lint": "eslint ."
	},
	"author": "Nathael Nogues",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": "^26.5.0"
	},
	"dependencies": {
		"axios": "^1.18.1",
		"body-parser": "^2.3.0",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.0",
		"express-session": "^1.19.0",
		"jimp": "^1.6.1",
		"js-yaml": "^5.2.1",
		"jssha": "^3.3.2",
		"lodash.debounce": "^4.0.8",
		"multer": "^2.2.0",
		"node": "^26.5.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8.2.0",
		"react-select": "^5.10.2",
		"uuid": "^14.0.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/NatNgs/Nanking"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-react": "^6.0.3",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"eslint": "^10.7.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.8.0",
		"playwright": "^1.56.0",
		"vite": "^8.1.5"
	}
}
